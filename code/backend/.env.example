# SlideSense backend local environment template
# Copy this to .env and fill in real values for local development.

# Server
SERVER_PORT=8080

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/slidesense
SPRING_DATASOURCE_USERNAME=slidesense
SPRING_DATASOURCE_PASSWORD=slidesense

# JWT / API security
SECURITY_JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
SECURITY_JWT_ACCESS_EXPIRATION_MS=900000
SECURITY_JWT_REFRESH_EXPIRATION_MS=604800000
SECURITY_API_KEY_HEADER=X-API-Key

# AWS / SQS ingestion
AWS_REGION=ap-southeast-1
AWS_PROFILE=default
SQS_INGESTION_ENABLED=false
SQS_INGESTION_QUEUE_URL=
SQS_INGESTION_MAX_MESSAGES=10
SQS_INGESTION_WAIT_SECONDS=10
SQS_INGESTION_POLL_DELAY_MS=2000
